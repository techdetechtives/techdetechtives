#!/usr/bin/env bash
# TechDetechtives OT IDS. Copyright (c) 2026 TechDetechtives. MIT licence.
#
# Replay an incident: what the sensor's engines made of a capture file that was
# uploaded to the product, or of a period of live traffic, in the order it
# happened: the ATT&CK tactics, every detection, what the traffic holds
# that the plant's normal traffic never did, and the other traffic around it.
# It reads what is stored and changes nothing. Run as the account that runs the
# product, on the server:
#
#   td-replay list                              the uploaded captures, by the words of their file names
#   td-replay report --tag incident7            one uploaded capture
#   td-replay report --from 2026-10-01T02:00 --to 2026-10-01T09:00      a period of live traffic (UTC)
#   td-replay report --tag incident7 --format markdown > incident7.md
#
# To replay a capture: put its packets in time order if it was exported from
# Arkime (td-pcap-order), give it a name the product has not seen, with one
# word of your own (incident7.pcap), upload it at https://<server>/upload/,
# wait a few minutes, then run the report. Before a replay that is to be
# compared with an earlier one, restart the Suricata that analyses uploads:
# cd ~/Malcolm && ./scripts/restart -s suricata
# docs/INCIDENT-REPLAY.md in the kit has the whole procedure and the reasons.

set -euo pipefail

DIR="${MALCOLM_DIR:-$HOME/Malcolm}"
[[ -f "$DIR/docker-compose.yml" ]] || { echo "[replay] $DIR does not look like the product folder (set MALCOLM_DIR)" >&2; exit 1; }
cd "$DIR"
if ! docker compose ps --services --status running 2>/dev/null | grep -qx dashboards-helper; then
  echo "[replay] the product is not running (start it with ./scripts/start)" >&2
  exit 1
fi
[[ $# -gt 0 ]] || set -- list
exec docker compose exec -T dashboards-helper python3 /opt/techdetechtives/td_replay.py "$@"
