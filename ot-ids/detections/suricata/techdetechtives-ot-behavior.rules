# TechDetechtives OT IDS: abnormal-behaviour Suricata rules.
# Copyright (c) 2026 TechDetechtives. MIT licence (see LICENSE).
# SID range reserved for this file: 1900401 - 1900449.
#
# The shared rules in platform/detections/suricata/ report single operations
# that are rare and consequential. These rules report patterns instead: an
# address doing an ordinary thing far more often, or to far more devices, than
# a control network normally sees. Each counts events and fires once per window
# while the rate stays above its figure ("type both").
#
# The figures are starting points, not measurements of your plant. A polling
# master, an asset-inventory tool or a commissioning laptop can cross them.
# Raise a count, or suppress a known address, rather than switching a rule off.
#
# These rules have passed the structure and byte-position tests in
# ot-ids/tests/. They have not been run in the engine or against plant traffic
# by their author; ./build-iso.sh checks them with the product's own Suricata.

# --- Modbus ----------------------------------------------------------------
alert modbus any any -> any any (msg:"TECHDETECHTIVES OT Behaviour - Modbus writes at an unusual rate from one address"; flow:to_server; modbus: access write; threshold: type both, track by_src, count 100, seconds 10; classtype:attempted-admin; priority:2; sid:1900401; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
alert tcp any 502 -> any any (msg:"TECHDETECHTIVES OT Behaviour - Modbus device answering with errors repeatedly (probing, fuzzing or a misconfigured client)"; flow:established,to_client; content:"|00 00|"; offset:2; depth:2; content:"|00 03|"; offset:4; depth:2; byte_test:1,&,128,7; threshold: type both, track by_dst, count 20, seconds 60; classtype:attempted-recon; priority:3; sid:1900403; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
# Device identification is matched by its bytes (function 43, interface type 14,
# at bytes 7 and 8 of a Modbus/TCP request): the decoder's "subfunction" option
# is compared for function 8 only and never matches function 43.
alert tcp any any -> any 502 (msg:"TECHDETECHTIVES OT Behaviour - Modbus device identification requested many times (inventory sweep)"; flow:established,to_server; content:"|00 00|"; offset:2; depth:2; content:"|2b 0e|"; offset:7; depth:2; threshold: type both, track by_src, count 10, seconds 60; classtype:attempted-recon; priority:2; sid:1900406; rev:2; metadata:created_at 2026_10_06, updated_at 2026_10_06;)

# --- Any controller port ---------------------------------------------------
# A master keeps its connections open. Thirty new connections a minute to
# controller ports from one address is a sweep, or a client stuck reconnecting.
alert tcp any any -> $HOME_NET [102,502,1911,2404,4840,9600,18245,20000,44818,55553,55555] (msg:"TECHDETECHTIVES OT Behaviour - One address opening many connections to controller ports (sweep)"; flags:S,12; threshold: type both, track by_src, count 30, seconds 60; classtype:attempted-recon; priority:2; sid:1900402; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)

# --- DNP3 ------------------------------------------------------------------
alert dnp3 any any -> any any (msg:"TECHDETECHTIVES OT Behaviour - DNP3 outstation keeps answering that a function is not supported (probing)"; flow:to_client; dnp3_ind:no_func_code_support; threshold: type both, track by_dst, count 5, seconds 60; classtype:attempted-recon; priority:2; sid:1900404; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
alert dnp3 any any -> any any (msg:"TECHDETECHTIVES OT Behaviour - DNP3 outstation keeps answering that an object is unknown (probing)"; flow:to_client; dnp3_ind:object_unknown; threshold: type both, track by_dst, count 5, seconds 60; classtype:attempted-recon; priority:2; sid:1900405; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)

# --- EtherNet/IP, BACnet, S7 discovery ---------------------------------------
alert udp any any -> any 44818 (msg:"TECHDETECHTIVES OT Behaviour - EtherNet/IP List Identity repeated (device discovery sweep)"; enip_command:99; threshold: type both, track by_src, count 20, seconds 60; classtype:attempted-recon; priority:3; sid:1900407; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
alert udp any any -> any 47808 (msg:"TECHDETECHTIVES OT Behaviour - BACnet Who-Is broadcast repeated (device discovery sweep)"; content:"|81 0b|"; depth:2; content:"|10 08|"; distance:2; within:10; threshold: type both, track by_src, count 30, seconds 60; classtype:attempted-recon; priority:3; sid:1900408; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
alert tcp any any -> any 102 (msg:"TECHDETECHTIVES OT Behaviour - S7 controller identity read many times (inventory sweep)"; flow:established,to_server; content:"|03 00|"; depth:2; content:"|02 f0 80 32 07|"; offset:4; depth:5; content:"|00 01 12 04 11 44 01|"; offset:17; depth:7; threshold: type both, track by_src, count 10, seconds 60; classtype:attempted-recon; priority:3; sid:1900411; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)

# --- File pushed to a device -------------------------------------------------
# TFTP has no login. It is how firmware and configuration reach many network
# and field devices, and it should be rare and planned.
alert udp any any -> $HOME_NET 69 (msg:"TECHDETECHTIVES OT Behaviour - File written to a device by TFTP (firmware or configuration push)"; content:"|00 02|"; depth:2; threshold: type limit, track by_src, seconds 300, count 1; classtype:attempted-admin; priority:2; sid:1900409; rev:1; metadata:created_at 2026_10_06, updated_at 2026_10_06;)
