# TechDetechtives analytics settings.
# Copy to config/techdetechtives.env and fill in. That file is git-ignored.

# --- Connection to the platform's Elasticsearch -------------------------------
# Hostname of the platform manager node (use the hostname, not the IP, so the
# TLS certificate matches). Leave empty to run the notebooks on bundled sample
# data only (demo mode).
TD_ES_HOST=
TD_ES_PORT=9200
# Read-only API key printed by platform/create-readonly-key.sh ("encoded" value).
TD_ES_API_KEY=
# CA certificate copied from the manager (/etc/pki/ca.crt) into analytics/certs/.
TD_ES_CA_CERT=/certs/so-ca.crt
# Set to false only if you must connect by IP address.
TD_ES_ASSERT_HOSTNAME=true

# --- Jupyter ------------------------------------------------------------------
# Required. Generate one with:  openssl rand -hex 32
TD_JUPYTER_TOKEN=
# Jupyter listens on localhost only by default. Reach it through an SSH tunnel,
# or put a TLS reverse proxy in front before changing this.
TD_JUPYTER_BIND=127.0.0.1
TD_JUPYTER_PORT=8888

# --- Spark ----------------------------------------------------------------------
# local[*] runs Spark inside the Jupyter container. Point this at
# spark://host:7077 to use an external cluster instead.
TD_SPARK_MASTER=local[*]
TD_SPARK_DRIVER_MEMORY=2g

# Force sample data even when TD_ES_HOST is set (1 = on).
TD_DEMO=0

# --- Ticketing (DFIR-IRIS) ------------------------------------------------------
# Filled in by ticketing/setup-iris.sh. Change them only to use a DFIR-IRIS
# that runs somewhere else on your internal network.
TD_IRIS_URL=
TD_IRIS_API_KEY=
TD_IRIS_CA_CERT=/iris-certs/iris-cert.pem
TD_IRIS_ASSERT_HOSTNAME=true
# DFIR-IRIS customer the tickets are filed under.
TD_IRIS_CUSTOMER=IrisInitialClient

# Lowest alert severity that opens a ticket: 1 low, 2 medium, 3 high, 4 critical.
TD_TICKET_MIN_SEVERITY=2
# How often the forwarder looks for new alerts, in seconds.
TD_TICKET_POLL_SECONDS=30
# Most tickets created per polling cycle; any extra follow in the next cycle.
TD_TICKET_MAX_PER_CYCLE=200
# On the very first start, also ticket alerts from this many minutes back (0 = only new alerts).
TD_TICKET_BACKFILL_MINUTES=0
# Address of the platform console, used for the link in each ticket.
# Defaults to https://<TD_ES_HOST>.
TD_SOC_URL=

# --- Vulnerability scanning (Greenbone / OpenVAS) -----------------------------
# Filled in by vulnerability/setup-greenbone.sh.
TD_GVM_USER=admin
TD_GVM_PASSWORD=
TD_GVM_URL=
# TechDetechtives vulnerability dashboard: sign-in, port and public address.
TD_VULN_USER=analyst
TD_VULN_PASSWORD=
TD_VULN_BIND=0.0.0.0
TD_VULN_PORT=8444
TD_VULN_PUBLIC_URL=
# How often finished scans are copied from Greenbone, in seconds.
TD_VULN_SYNC_SECONDS=300
# Ignore detections below this confidence (Greenbone "quality of detection", percent).
TD_VULN_MIN_QOD=70

# Sending findings into the platform. Paste the key printed by
# platform/create-ingest-key.sh. Leave empty to keep findings on this host only.
TD_ES_INGEST_API_KEY=
TD_VULN_TO_PLATFORM=1

# Tickets for findings: lowest CVSS score that opens a DFIR-IRIS ticket
# (4.0 = medium and above, 7.0 = high and above). Set TD_VULN_TICKETS=0 to turn them off.
TD_VULN_TICKETS=1
TD_VULN_TICKET_MIN_CVSS=4.0
TD_VULN_TICKET_MAX_PER_CYCLE=200

# --- Network inventory and traffic map -----------------------------------------
# Built from the platform's records with the read-only key above (TD_ES_API_KEY).
# Sign-in, port and address of the pages; filled in by network/setup-network.sh.
TD_NET_USER=analyst
TD_NET_PASSWORD=
TD_NET_BIND=0.0.0.0
TD_NET_PORT=8445
TD_NET_PUBLIC_URL=
# Name shown on the alerts this part raises.
TD_NET_NAME=
# The networks that are yours, comma separated. Everything else is shown as
# one item, "Outside". Empty = every private range.
TD_NET_INSIDE=
# Names for parts of your network: Control=10.10.1.0/24,Office=172.16.0.0/16
# Empty = each /24 network is its own zone.
TD_NET_ZONES=
# For this many hours after the first records arrive, everything seen is taken
# as normal. After that, new devices, new industrial conversations and new
# control commands are listed as changes.
TD_NET_LEARN_HOURS=72
# How often the platform is read, in seconds, and how far back the first read goes.
TD_NET_SYNC_SECONDS=300
TD_NET_BACKFILL_HOURS=24
# Records are read this many seconds after the sensor wrote them, to give them
# time to reach the platform. Raise it if the pages say records arrived too late.
TD_NET_LAG_SECONDS=300
# Sending changes to the platform as alerts (medium and above then become
# tickets). Paste the key printed by: sudo platform/create-ingest-key.sh --for network
# Leave empty to keep changes on the pages only.
TD_NET_INGEST_API_KEY=
TD_NET_TO_PLATFORM=1

# Published advisories, matched against the devices, scan findings and the
# products listed below. Set with: scripts/install.sh network --advisories on|off --watch "..."
# Feeds, as NAME=FORMAT:https://ADDRESS separated by commas (formats: rss, kev,
# csaf-feed, csaf). Empty = JPCERT/CC, JVN, JVN iPedia, CISA ICS advisories and
# CISA's catalogue of exploited vulnerabilities. off = none: only files put in
# network/advisories/ are read (for machines without internet access).
TD_ADV_FEEDS=
# Products this site runs that do not announce themselves on the network,
# separated by ';', for example: Honeywell Experion PKS; Honeywell C300
TD_ADV_WATCH=
# Web proxy for fetching advisories (used for nothing else), for example http://proxy.example:3128
TD_ADV_PROXY=
# How often each feed is checked, in hours.
TD_ADV_FETCH_HOURS=6
# CISA advisories are listed by title; the full advisory is fetched for those
# updated within this many days, and for older ones about vendors seen here.
TD_ADV_RECENT_DAYS=365
# Scan findings of this many days are matched by CVE.
TD_ADV_FINDING_DAYS=30
TD_ADV_ENABLED=1

# --- Honeypot (OpenCanary) ---------------------------------------------------
# Most of these are filled in by honeypot/setup-honeypot.sh.
# Name and address of this honeypot as shown on alerts.
TD_HONEYPOT_NAME=
TD_HONEYPOT_IP=
# Decoys offered, and ports changed from their usual ones (for example ssh=2222).
TD_HONEYPOT_SERVICES=
TD_HONEYPOT_PORTS=
TD_HONEYPOT_PORT_MAP=
TD_HONEYPOT_BIND=0.0.0.0
# Paste the key printed by: sudo platform/create-ingest-key.sh --for honeypot
TD_HONEYPOT_API_KEY=
# After an alert, further contacts from the same address to the same decoy are
# stored as plain events for this many minutes instead of raising new alerts.
TD_HONEYPOT_REPEAT_MINUTES=30
# Addresses or ranges that are allowed to touch the honeypot without any record
# on the platform, comma separated. Put your vulnerability scanner here.
TD_HONEYPOT_IGNORE_IPS=
# Passwords typed into a decoy are left out of what is sent to the platform.
# Set to 1 to include them (a colleague's mistyped real password would then be
# visible to everyone who can read alerts and tickets).
TD_HONEYPOT_KEEP_PASSWORDS=0
# Set by the setup script from upstream.lock.
TD_OPENCANARY_COMMIT=
TD_OPENCANARY_VERSION=

# --- Branding of the TechDetechtives dashboard --------------------------------
# Name shown in the header, browser tab and sign-in prompt.
TD_BRAND_NAME=TechDetechtives
# Header band colour and accent colour, written as #rrggbb.
TD_BRAND_HEADER=#0b0b0d
TD_BRAND_ACCENT=#f60411
# Logo file inside the branding/ folder (svg, png, jpg or webp, up to 512 KB).
TD_BRAND_LOGO=/brand/logo.png
