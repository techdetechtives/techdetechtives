# TechDetechtives analytics settings.
# Copy to config/techdetechtives.env and fill in. That file is git-ignored.

# --- Connection to the platform's Elasticsearch -------------------------------
# Hostname of the platform manager node (use the hostname, not the IP, so the
# TLS certificate matches). Leave empty to run the notebooks on bundled sample
# data only (demo mode).
TD_ES_HOST=
TD_ES_PORT=9200
# Read-only API key printed by platform/create-readonly-key.sh ("encoded" value).
TD_ES_API_KEY=
# CA certificate copied from the manager (/etc/pki/ca.crt) into analytics/certs/.
TD_ES_CA_CERT=/certs/so-ca.crt
# Set to false only if you must connect by IP address.
TD_ES_ASSERT_HOSTNAME=true

# --- Jupyter ------------------------------------------------------------------
# Required. Generate one with:  openssl rand -hex 32
TD_JUPYTER_TOKEN=
# Jupyter listens on localhost only by default. Reach it through an SSH tunnel,
# or put a TLS reverse proxy in front before changing this.
TD_JUPYTER_BIND=127.0.0.1
TD_JUPYTER_PORT=8888

# --- Spark ----------------------------------------------------------------------
# local[*] runs Spark inside the Jupyter container. Point this at
# spark://host:7077 to use an external cluster instead.
TD_SPARK_MASTER=local[*]
TD_SPARK_DRIVER_MEMORY=2g

# Force sample data even when TD_ES_HOST is set (1 = on).
TD_DEMO=0

# --- Ticketing (DFIR-IRIS) ------------------------------------------------------
# Filled in by ticketing/setup-iris.sh. Change them only to use a DFIR-IRIS
# that runs somewhere else on your internal network.
TD_IRIS_URL=
TD_IRIS_API_KEY=
TD_IRIS_CA_CERT=/iris-certs/iris-cert.pem
TD_IRIS_ASSERT_HOSTNAME=true
# DFIR-IRIS customer the tickets are filed under.
TD_IRIS_CUSTOMER=IrisInitialClient

# Lowest alert severity that opens a ticket: 1 low, 2 medium, 3 high, 4 critical.
TD_TICKET_MIN_SEVERITY=2
# How often the forwarder looks for new alerts, in seconds.
TD_TICKET_POLL_SECONDS=30
# Most tickets created per polling cycle; any extra follow in the next cycle.
TD_TICKET_MAX_PER_CYCLE=200
# On the very first start, also ticket alerts from this many minutes back (0 = only new alerts).
TD_TICKET_BACKFILL_MINUTES=0
# Address of the platform console, used for the link in each ticket.
# Defaults to https://<TD_ES_HOST>.
TD_SOC_URL=

# --- Vulnerability scanning (Greenbone / OpenVAS) -----------------------------
# Filled in by vulnerability/setup-greenbone.sh.
TD_GVM_USER=admin
TD_GVM_PASSWORD=
TD_GVM_URL=
# TechDetechtives vulnerability dashboard: sign-in, port and public address.
TD_VULN_USER=analyst
TD_VULN_PASSWORD=
TD_VULN_BIND=0.0.0.0
TD_VULN_PORT=8444
TD_VULN_PUBLIC_URL=
# How often finished scans are copied from Greenbone, in seconds.
TD_VULN_SYNC_SECONDS=300
# Ignore detections below this confidence (Greenbone "quality of detection", percent).
TD_VULN_MIN_QOD=70

# Sending findings into the platform. Paste the key printed by
# platform/create-ingest-key.sh. Leave empty to keep findings on this host only.
TD_ES_INGEST_API_KEY=
TD_VULN_TO_PLATFORM=1

# Tickets for findings: lowest CVSS score that opens a DFIR-IRIS ticket
# (4.0 = medium and above, 7.0 = high and above). Set TD_VULN_TICKETS=0 to turn them off.
TD_VULN_TICKETS=1
TD_VULN_TICKET_MIN_CVSS=4.0
TD_VULN_TICKET_MAX_PER_CYCLE=200

# --- Branding of the TechDetechtives dashboard --------------------------------
# Name shown in the header, browser tab and sign-in prompt.
TD_BRAND_NAME=TechDetechtives
# Header band colour and accent colour, written as #rrggbb.
TD_BRAND_HEADER=#0b0b0d
TD_BRAND_ACCENT=#f60411
# Logo file inside the branding/ folder (svg, png, jpg or webp, up to 512 KB).
TD_BRAND_LOGO=/brand/logo.png
