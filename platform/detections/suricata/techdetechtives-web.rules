# TechDetechtives web attack rules: PHP code execution and web shells.
# SID range reserved for this file: 1900401 - 1900499.
# Rules made by the rule factory for single CVEs go in techdetechtives-cve.rules.
# The sensor reads only plain HTTP, or HTTPS that is decrypted before it.
alert http any any -> $HOME_NET any (msg:"TECHDETECHTIVES Exploit - PHP-CGI argument injection with a soft hyphen (CVE-2024-4577)"; flow:established,to_server; http.uri.raw; content:"%ad"; nocase; pcre:"/%ad[dn](?:\+|%20|%09)*[a-z_.]+(?:%3d|=)/i"; reference:cve,2024-4577; classtype:web-application-attack; priority:1; sid:1900401; rev:1; metadata:created_at 2026_11_03, updated_at 2026_11_03;)
alert http any any -> $HOME_NET any (msg:"TECHDETECHTIVES Exploit - PHP-CGI option injection turns on remote code (CVE-2012-1823 family)"; flow:established,to_server; http.uri.raw; pcre:"/[?+&](?:-|%2d)d(?:\+|%20)+(?:allow_url_include|auto_prepend_file|auto_append_file)/i"; reference:cve,2012-1823; classtype:web-application-attack; priority:1; sid:1900402; rev:1; metadata:created_at 2026_11_03, updated_at 2026_11_03;)
alert http any any -> $HOME_NET any (msg:"TECHDETECHTIVES Web Shell - Operating system command in a request parameter"; flow:established,to_server; http.uri; content:"="; pcre:"/[?&](?:cmd|c|exec|command|execute|run|shell|x)=[^&]{0,40}?(?:whoami|uname(?:\+|%20|\s)+-a|cat(?:\+|%20|\s)+\/etc\/passwd|net(?:\+|%20|\s)+user|ipconfig|ifconfig|\bid\b(?:$|&|\;|\|))/i"; classtype:web-application-attack; priority:2; sid:1900403; rev:1; metadata:created_at 2026_11_03, updated_at 2026_11_03;)
alert http any any -> $HOME_NET any (msg:"TECHDETECHTIVES Web Shell - PHP code that runs commands sent in a request body"; flow:established,to_server; http.request_body; content:"<?php"; nocase; pcre:"/<\?php[\s\S]{0,300}?\b(?:system|passthru|shell_exec|exec|popen|proc_open|pcntl_exec)\s*\(/i"; classtype:web-application-attack; priority:2; sid:1900404; rev:1; metadata:created_at 2026_11_03, updated_at 2026_11_03;)
